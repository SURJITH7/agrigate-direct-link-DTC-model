# AgriGate Environment Configuration

# === SERVER CONFIGURATION ===
PORT=5000

# === DATABASE CONFIGURATION ===
# MongoDB Atlas URI (Online)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.cnwd3su.mongodb.net/AgriGateDB?retryWrites=true&w=majority&appName=Cluster0

# Local MongoDB (Offline)
# MONGO_URI=mongodb://localhost:27017/AgriGate

# === JWT AUTHENTICATION ===
JWT_SECRET=your_jwt_secret_key_here

# === RAZORPAY CONFIGURATION ===
# Get these from: https://dashboard.razorpay.com/app/keys
# DO NOT share RAZORPAY_KEY_SECRET with frontend - keep it backend only!
RAZORPAY_KEY_ID=rzp_test_1wNfgXweHNhUpcdHhx4sHjST
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# === EMAIL CONFIGURATION FOR OTP ===
# Get app-specific password from: https://myaccount.google.com/apppasswords
# Only for OTP verification during registration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email_id_here
EMAIL_PASSWORD=your_app_specific_password_here

# === SMS CONFIGURATION FOR OTP (OPTIONAL) ===
# Get credentials from: https://www.twilio.com/console
# Leave these blank to disable SMS - users will only see Email option
# Only needed if you want SMS OTP as an alternative verification method
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=your_twilio_phone_number
