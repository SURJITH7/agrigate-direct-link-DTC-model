# AgriGate Frontend Environment Configuration

# === RAZORPAY: FRONTEND CONFIGURATION ===
# IMPORTANT: Only use Key ID here (get from https://dashboard.razorpay.com/app/keys)
# NEVER put Key Secret in frontend code - it's secret and must only be in backend .env!

# Test Mode Key ID (for development/testing)
VITE_RAZORPAY_KEY_ID=rzp_test_1wNfgXweHNhUpcdHhx4sHjST

# Production Key ID (use when deploying to production)
# VITE_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX

# === OTHER CONFIGURATION ===
# Leaflet + OpenStreetMap is completely free and requires no API key

EMAIL_SERVICE=gmail
EMAIL_USER=your_email_id_here
EMAIL_PASSWORD=your_app_specific_password_here

# === SMS CONFIGURATION FOR OTP (OPTIONAL) ===
# Get credentials from: https://www.twilio.com/console
# Leave these blank to disable SMS - users will only see Email option
# Only needed if you want SMS OTP as an alternative verification method
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=your_twilio_phone_number